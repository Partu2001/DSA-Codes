package tree;

class Node{
	int data;
	Node right,left;
	boolean rthread,lthread;
	
	public Node(int data) {
		this.data=data;
		right=left=null;
		rthread=false;
		lthread=false;
	}
}

public class ThreadedBinaryTree {

	
	public static Node leftmost(Node node) {	
		if(node==null) {
			return null;
		}
		while(!node.lthread) {
			node=node.left;
		}
		return node;
	}
	
	
	public static void inorder(Node root) {
		Node curr=leftmost(root);
		
		while(curr!=null) {
			System.out.println(curr.data + " ");
		}
		if(curr.rthread) {
			curr=curr.right;
		}
		else {
			curr=leftmost(curr.right);
		}
		
	}
	
	
	public static void main(String[] args) {
		
		Node root=new Node(20);
		Node n1=new Node(10);

	}

}
