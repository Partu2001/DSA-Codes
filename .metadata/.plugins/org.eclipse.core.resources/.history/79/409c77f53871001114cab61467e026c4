package queue;

public class TestQueue {

	int arr[];
	int front,rear,size,n;
	
	public TestQueue(){
		this.n=n;
		arr=new int[n];
		front=0;
		rear=-1;
		size=0;
	}
	
	public void enqueue(int n) {
		if(size==n) {
			System.out.println("Queue Overflow");
			return;
		}
		front++;
	    arr[rear]=n;
		rear--;
	}
	
	public void dqueue() {
		if(size==0) {
			System.out.println("Queue underflow");
			return;
		}
		System.out.println("Removed : " + arr[front]);
		front--;
		rear++;
	}
	
	public void peek() {
		if(size==0) {
			System.out.println("Queue is empty");
			return;
		}
		System.out.println("Head: " + arr[front]);
	}
	
	public void display() {
		
		if(size==0) {
			System.out.println("Queue is empty");
			return;
		}
		for(int i=front;i>=0;i++) {
			System.out.println("Queue : " +arr[i]);
		}
		
	}
	
	
	public static void main(String[] args) {
		
		TestQueue q=new TestQueue();
		q.enqueue(10);
		q.enqueue(20);
		q.enqueue(30);
		q.enqueue(40);
		q.enqueue(50);
		
		q.dqueue();
		
		q.peek();
		
		q.display();
		

	}

}
