package linkedlist;
class Node{
	int data;
	Node next;
	
	
	public Node(int data) {
		this.data=data;
		this.next=null;
	}
}

public class CircularLinkedList {
	Node head=null;
	Node tail=null;
	
	
	public void insertList(int data) {
		Node newNode =new Node(data);
		if(head==null) {
				head=tail=newNode;
				tail.next=head;
		}
		else {
			tail.next=newNode;
			tail=newNode;
			tail.next=head;
		}
	}
	
	
	public void display() {
		if(head==null) {
			System.out.println("List is Empty");
			return;
		}
		Node temp=head;
		do {
			System.out.println(temp.data + " ");
			temp=temp.next;
		}while(temp!=head);
		System.out.println();
	}
	
	
	public static void main(String[] args) {
		CircularLinkedList cl=new CircularLinkedList();
		cl.insertList(10);
		cl.insertList(20);
		cl.insertList(30);
		cl.insertList(40);
		cl.insertList(50);
		cl.display();
	}
}
