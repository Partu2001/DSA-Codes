package linkedlist;

class Node{
	int data;
	Node next;
	
	Node(int data){
		this.data=data;
		this.next=null;
	}
}

public class SingleLinkedList {

	Node head;
	
	 public void insertList(int data) {
		 Node newNode=new Node(data);
		 if(head==null)
		 {
			 head=newNode;
			 return;
		 }
		 Node  temp=head;
		 while(temp.next!=null) {
			 temp=temp.next;
		 }
		 
		 temp.next=newNode;
		}
	 
	 public void search(int value) {
		 Node temp=head;
		 while(temp!=null) {
			 if(temp.data==value) {
				 System.out.println("Number found :" + value);
			 }
			 temp=temp.next;
		 }
		 System.out.println("Number not found :" + value);
	 }
	 
	 public void  display() {
		 Node temp=head;
		 while(temp!=null) {
			 System.out.print(temp.data + "->");
			 temp=temp.next;
		 }
		 
		 System.out.print("Null");
	 }
	 
	 public static void main(String[] args) {
		
		 SingleLinkedList sl=new SingleLinkedList();
		 sl.insertList(10);
		 sl.insertList(20);
		 sl.insertList(30);
		 sl.insertList(40);
		 sl.insertList(50);
		 sl.display();
		 
		 sl.search(30);
		 sl.display();
	}
}
