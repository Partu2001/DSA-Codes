package linkedlist;
class Node{
	int data;
	Node next;
	
	public Node(int data) {
		this.data=data;
		this.next=null;
	}
}

public class CircularLinkedList {

	Node head=null;
	Node tail=null;
	
	public void insertList(int data) {
		Node newNode =new Node(data);
		if(head==null) {
				head=tail=newNode;
				tail.next=head;
		}
		else {
			tail.next=newNode;
			tail=newNode;
			tail.next=head;
		}
	}
	
	public void display() {
		if(head==null) {
			System.out.println("List is Empty");
		}
	}
}
