package linkedlist;

class Node {
    int data;
    Node next;

    Node(int data) {
        this.data = data;
        this.next = null;
    }
}

public class SingleLinkedList {

    Node head;

    // Insert at end
    public void insertList(int data) {
        Node newNode = new Node(data);

        if (head == null) {
            head = newNode;
            return;
        }

        Node temp = head;
        while (temp.next != null) {
            temp = temp.next;
        }

        temp.next = newNode;
    }

    // Display list
    public void disply() {
        Node temp = head;

        while (temp != null) {
            System.out.print(temp.data + " -> ");
            temp = temp.next;
        }

        System.out.println("NULL");
    }

    // Search key
    public boolean search(int key) {
        Node temp = head;

        while (temp != null) {
            if (temp.data == key) {
                return true;
            }
            temp = temp.next;
        }

        return false;
    }

    public static void main(String[] args) {

        SingleLinkedList sl = new SingleLinkedList();

        sl.insertList(10);
        sl.insertList(20);
        sl.insertList(30);
        sl.insertList(40);

        sl.disply();

        int key = 5;

        if (sl.search(key)) {
            System.out.println(key + " found in linked list");
        } else {
            System.out.println(key + " not found in linked list");
        }
    }
}